# Server Configuration
PORT=8001
HOST=0.0.0.0

# PayPal Sandbox Credentials (Orders V2 & OAuth2)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Model-Agnostic LLM Engine Configuration
# Options: gemini | openai_compat | mock
LLM_PROVIDER=gemini

# Primary: Google Gemini Direct API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative / Fallback: OpenAI-Compatible REST API (e.g. OpenRouter, OpenAI, Groq, vLLM)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=google/gemini-2.5-flash

# Cryptographic Deal Locking & Guardrails
DEAL_SIGNING_SECRET=ampelbot-secret-deal-signing-key-hackathon-2026
REQUIRE_DEAL_LOCK=false
